# Base de données (Supabase Postgres via Prisma)
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Auth
AUTH_SECRET="[generate with: openssl rand -base64 32]"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Envoi d'e-mails (newsletter + confirmation de commande)
# Avec Gmail : utiliser un "mot de passe d'application" (pas le mot de passe du compte),
# généré sur https://myaccount.google.com/apppasswords
SMTP_USER="[adresse@gmail.com]"
SMTP_PASSWORD="[mot de passe d'application]"
SMTP_FROM_NAME="Jeune Riche"

# Monitoring d'erreurs (Sentry) — créer un projet gratuit sur sentry.io
# (plateforme "Next.js"), le DSN se trouve dans Settings > Projects > <projet> > Client Keys.
# Sans ces variables, le site fonctionne normalement, juste sans remontée d'erreurs.
SENTRY_DSN="[dsn-serveur]"
NEXT_PUBLIC_SENTRY_DSN="[même dsn, exposé au navigateur — un DSN Sentry est conçu pour être public]"
# Optionnel : uniquement pour uploader les source maps au build (org/projet
# Sentry + jeton d'API créé sur sentry.io > Settings > Auth Tokens).
SENTRY_ORG="[org-sentry]"
SENTRY_PROJECT="[projet-sentry]"
SENTRY_AUTH_TOKEN="[jeton-api-sentry]"

# Relance panier abandonné (voir app/api/cron/abandoned-cart) — Vercel envoie
# automatiquement "Authorization: Bearer $CRON_SECRET" sur ses appels cron
# quand cette variable est définie sur le projet. Générer une valeur aléatoire
# (ex. openssl rand -hex 32) ; sans elle, la route cron refuse tout appel.
CRON_SECRET="[valeur aléatoire longue]"

# Notifications sur le téléphone du client (lib/push) : clés dérivées de
# CRON_SECRET, rien à configurer (voir lib/push/keys.ts).

# Référencement Google (facultatif mais fortement recommandé)
# Connexion Google en direct (app/auth/google) : Google affiche le nom du
# site au lieu de <projet>.supabase.co. Mêmes valeurs que dans Supabase →
# Authentication → Providers → Google. Absentes : connexion via Supabase.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="[identifiant client].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="[code secret du client]"

# Code fourni par Google Search Console → Propriété > Balise HTML.
# Coller UNIQUEMENT la valeur de content="...", pas la balise entière.
GOOGLE_SITE_VERIFICATION="[code fourni par Search Console]"

# Anti-abus partagé (facultatif mais recommandé) — Upstash Redis, offre gratuite.
# Le plus simple : Vercel → projet → Storage → « Upstash for Redis » → Connect,
# qui pose KV_REST_API_URL / KV_REST_API_TOKEN tout seul. Sans ces variables,
# le limiteur reste en mémoire (une instance à la fois).
UPSTASH_REDIS_REST_URL="[https://xxxx.upstash.io]"
UPSTASH_REDIS_REST_TOKEN="[jeton REST]"

# Entrée secrète de l'administration (voir lib/admin/gate.ts). Sans cette
# variable, /admin reste accessible à tous. Avec : /admin répond un 404 pour
# tout le monde, sauf après un passage par https://<site>/<ADMIN_ENTRY_KEY>.
# 32 caractères minimum, lettres/chiffres/-/_ (ex. : openssl rand -base64 33 | tr '+/' '-_').
ADMIN_ENTRY_KEY="[clé secrète aléatoire]"

# Double vérification de l'admin (voir README). Ne définir qu'en secours : "off" la désactive.
# ADMIN_MFA="off"
