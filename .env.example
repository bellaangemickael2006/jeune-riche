# Base de données (Supabase Postgres via Prisma)
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Auth
AUTH_SECRET="[generate with: openssl rand -base64 32]"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Envoi d'e-mails (newsletter + confirmation de commande)
# Avec Gmail : utiliser un "mot de passe d'application" (pas le mot de passe du compte),
# généré sur https://myaccount.google.com/apppasswords
SMTP_USER="[adresse@gmail.com]"
SMTP_PASSWORD="[mot de passe d'application]"
SMTP_FROM_NAME="Jeune Riche"
